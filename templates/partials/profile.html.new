<script>
  // Mirror canonical balances into Home Payouts row
(function mirrorBalances() {
  const pairs = [
    ['actual-balance', 'actual-balance-mirror'],
    ['wallet-balance', 'wallet-balance-mirror'],
    ['referral-bonus', 'referral-bonus-mirror'],
    ['heroLockedBalance', 'heroLockedBalance-mirror']
  ];
  function sync() {
    pairs.forEach(([src, dst]) => {
      const s = document.getElementById(src);
      const d = document.getElementById(dst);
      if (s && d) d.textContent = s.textContent;
    });
  }
  sync();
  new MutationObserver(sync).observe(document.getElementById('expressMain'), {
    childList: true, subtree: true, characterData: true
  });
})();
</script>

